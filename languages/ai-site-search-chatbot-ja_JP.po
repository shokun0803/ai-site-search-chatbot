msgstr "ソースとして使用する検索結果の最大件数です。"

#: includes/class-ai-site-search-chatbot.php:220
msgid "How to get your API Key:"
msgstr "API キーの取得手順"

#: includes/class-ai-site-search-chatbot.php:231
msgid "Note:"
msgstr "注意"

#: includes/class-ai-site-search-chatbot.php:291
msgid "OpenAI"
msgstr "OpenAI"

#: includes/class-ai-site-search-chatbot.php:292
msgid "GPT-4, GPT-3.5 Turbo and more"
msgstr "GPT-4、GPT-3.5 Turbo など"

#: includes/class-ai-site-search-chatbot.php:296
msgid "Go to https://platform.openai.com/api-keys"
msgstr "https://platform.openai.com/api-keys にアクセスします。"

#: includes/class-ai-site-search-chatbot.php:297
msgid "Sign in or create an OpenAI account"
msgstr "OpenAI アカウントにサインイン、または新規作成します。"

#: includes/class-ai-site-search-chatbot.php:298
msgid "Click \"Create new secret key\""
msgstr "「Create new secret key」をクリックします。"

#: includes/class-ai-site-search-chatbot.php:299
